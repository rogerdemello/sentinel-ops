# =========================================================================
# SentinelOps AI — environment configuration
# Copy to `.env` (repo root). Everything is OPTIONAL: with no values set the
# platform runs fully (in-memory persistence + heuristic RCA).
# =========================================================================

# --- Simulator ---
SIM_TICK_SECONDS=2.0          # wall-clock seconds between ticks
SIM_MINUTES_PER_TICK=1.0      # simulated minutes advanced per tick
SIM_AUTOSTART=true

# --- Supabase (optional: enables write-through persistence + Realtime) ---
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=<service-role-key>

# --- Azure OpenAI (primary LLM for RCA + remediation reasoning) ---
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=<key>
# AZURE_OPENAI_API_VERSION=2024-06-01
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Azure OpenAI embeddings (enables RAG incident memory via pgvector) ---
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# --- Google Gemini (failover LLM) ---
# GEMINI_API_KEY=<key>
# GEMINI_MODEL=gemini-1.5-pro

# --- LLM routing ---
LLM_PRIMARY=azure             # azure | gemini  (other is automatic failover)
LLM_MAX_RETRIES=2

# --- Telemetry source (system | synthetic | prometheus) ---
# system    = REAL host metrics via psutil (default) — CPU/mem/disk/net are measured
#             live, so loading the machine drives genuine predictions.
# synthetic = scripted demo generator (fully deterministic, offline).
# prometheus= scrape a real Prometheus server (set PROMETHEUS_URL/QUERIES).
TELEMETRY_SOURCE=system
# PROMETHEUS_URL=http://localhost:9090
# PROMETHEUS_QUERIES=[{"query":"...","service_id":"gateway","metric":"cpu_pct"}]

# --- Forecasting backend (trend | holtwinters | prophet) ---
FORECASTER=trend

# --- Neo4j graph backend (optional; NetworkX used if unset) ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# --- Remediation execution (simulated | kubernetes | webhook) ---
REMEDIATION_EXECUTOR=simulated
# REMEDIATION_WEBHOOK_URL=
RBAC_ENABLED=false

# --- Alerting integrations (optional) ---
# SLACK_WEBHOOK_URL=
# PAGERDUTY_ROUTING_KEY=
# ALERT_WEBHOOK_URL=

# --- API auth + RBAC (optional; when API_KEY is set, /api/* requires it) ---
# The caller's RBAC role is derived from WHICH key authenticated the request —
# never from a client header — so remediation cannot be escalated by spoofing.
# API_KEY=            # grants the "operator" role
# ADMIN_API_KEY=      # grants the "admin" role (can execute higher-risk plans)
# DEFAULT_ROLE=operator  # role when auth is disabled (viewer | operator | admin)

# --- Autonomous self-healing ---
# When true, the engine auto-executes remediation plans whose max action risk is
# at/below AUTO_REMEDIATE_MAX_RISK; riskier plans still await human approval.
# (Also togglable live from the dashboard.)
AUTO_REMEDIATE=false
AUTO_REMEDIATE_MAX_RISK=low   # low | medium | high | critical

# --- Frontend (Vite) Supabase Realtime (optional) ---
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-key>
